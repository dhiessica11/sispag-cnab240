# Copie para .env e preencha. NUNCA versione o .env real.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=senha_de_app_16_letras
SMTP_STARTTLS=1
EMAIL_FROM=usuario@example.com
EMAIL_TO=destino1@example.com,destino2@example.com

# pastas _classificados separadas por ; (uma por unidade/empresa)
CLASSIFICADOS=C:/dados/UNIDADE1/_classificados;C:/dados/UNIDADE2/_classificados

# 1 = nao envia (so simula). Coloque 0 para enviar de verdade.
DRY_RUN=1
